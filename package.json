{
  "name": "humeto-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 4174",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local --test --test-concurrency=1 tests/*.mjs",
    "seed:assets": "node --env-file-if-exists=.env.local scripts/seed-demo-assets.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "test:release": "node --env-file-if-exists=.env.local scripts/test-release.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "db:seed": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed-demo.mts",
    "db:import-sqlite": "node --env-file-if-exists=.env.local scripts/import-sqlite.mjs",
    "db:start": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:status": "node scripts/local-postgres.mjs status",
    "db:setup-local": "node scripts/setup-local-postgres.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup-postgres.mjs",
    "ocr:worker": "node --env-file-if-exists=.env.local scripts/ocr-worker.mjs",
    "seed:ocr": "node --env-file-if-exists=.env.local scripts/seed-ocr-demo.mjs",
    "db:verify-backup": "node --env-file-if-exists=.env.local scripts/verify-postgres-backup.mjs",
    "whatsapp:worker": "node --env-file-if-exists=.env.local scripts/whatsapp-worker.mjs",
    "tasks:worker": "node --env-file-if-exists=.env.local scripts/task-worker.mjs",
    "seed:notebook": "node --env-file-if-exists=.env.local scripts/seed-notebook-demo.mjs",
    "test:android": "node --env-file-if-exists=.env.local scripts/test-android.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@vercel/functions": "^3.10.3",
    "@whiskeysockets/baileys": "^6.7.24",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.62.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
