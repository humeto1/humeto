{
  "manifest_version": 3,
  "name": "Humeto Assist — Local Alpha",
  "version": "0.4.0",
  "description": "Review matches from one paired applicant on the current form. Local development alpha.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": [
    "http://localhost:4173/*",
    "http://127.0.0.1:4173/*",
    "http://localhost:4174/*",
    "http://127.0.0.1:4174/*"
  ],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Humeto Assist" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
