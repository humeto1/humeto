# Enable only for loopback-only local development with fictional data.
HUMETO_LOCAL_DEMO=false
HUMETO_DATA_DIR=.data

# Task assistant: local command testing works without an external AI account.
HUMETO_AGENT_PROVIDER=local
# To use the live OpenAI adapter, set provider=openai and configure both values
# server-side. Never use NEXT_PUBLIC_ variables for these credentials.
# OPENAI_API_KEY=
# HUMETO_AGENT_MODEL=your-enabled-structured-output-model

# Required server-side PostgreSQL URL; use db:setup-local to generate local credentials.
DATABASE_URL=postgresql://humeto_app:CHANGE_ME@127.0.0.1:55432/humeto
# Development-only admin connection for disposable QA databases. Generated by local setup.
# Never use this privileged connection for application requests.
# HUMETO_PG_ADMIN_URL=
# Optional path to PostgreSQL binaries for local start/backup tools.
# HUMETO_PG_BIN=

# Local OCR is processed by a separate worker; no external document service.
HUMETO_OCR_ENABLED=false
# Optional explicit binary paths: HUMETO_TESSERACT_BIN, HUMETO_PDFINFO_BIN,
# HUMETO_PDFTOTEXT_BIN, HUMETO_PDFTOPPM_BIN.

# Self-hosted WhatsApp worker only. Generate 32 random bytes encoded as base64.
# Keep this key private and back it up separately; never expose to NEXT_PUBLIC variables.
HUMETO_WHATSAPP_KEY=

# Neon: pooled URL above for app traffic; direct URL below for migrations/dumps.
# DATABASE_URL_UNPOOLED=
# Optional per-process connection cap (1–20); Vercel defaults to 5, local to 10.
# HUMETO_DB_POOL_MAX=5
# Separate LOCAL base connection when DATABASE_URL points at Neon.
# HUMETO_TEST_DATABASE_URL=postgresql://humeto_app:CHANGE_ME@127.0.0.1:55432/humeto
# Optional private GitHub CLI credential; never expose as NEXT_PUBLIC_.
# GITHUB_TOKEN=

# Pause new public registrations without disabling existing signins.
HUMETO_SIGNUP_ENABLED=true
# Optional transactional email provider (never commit live credentials).
RESEND_API_KEY=
HUMETO_EMAIL_FROM=
# Canonical HTTPS origin used in verification, recovery and unsubscribe links.
HUMETO_PUBLIC_APP_URL=https://www.humeto.com
# Designated super admin; access is granted only after verified account ownership.
HUMETO_SUPER_ADMIN_EMAIL=
# Private stable signing key for optional-email unsubscribe links (32 random bytes).
HUMETO_EMAIL_LINK_SECRET=

# Humeto Assistant: set provider=openai to enable; only gpt-5.4-mini is used.
# CHATGPT_HUMETO_API=
