# Enable only for loopback-only local development with fictional data.
HUMETO_LOCAL_DEMO=false
HUMETO_DATA_DIR=.data

# Task assistant: local command testing works without an external AI account.
HUMETO_AGENT_PROVIDER=local
# To use the live OpenAI adapter, set provider=openai and configure both values
# server-side. Never use NEXT_PUBLIC_ variables for these credentials.
# OPENAI_API_KEY=
# HUMETO_AGENT_MODEL=your-enabled-structured-output-model

# Required server-side PostgreSQL URL; use db:setup-local to generate local credentials.
DATABASE_URL=postgresql://humeto_app:CHANGE_ME@127.0.0.1:55432/humeto
# Development-only admin connection for disposable QA databases. Generated by local setup.
# Never use this privileged connection for application requests.
# HUMETO_PG_ADMIN_URL=
# Optional path to PostgreSQL binaries for local start/backup tools.
# HUMETO_PG_BIN=

# Local OCR is processed by a separate worker; no external document service.
HUMETO_OCR_ENABLED=false
# Optional explicit binary paths: HUMETO_TESSERACT_BIN, HUMETO_PDFINFO_BIN,
# HUMETO_PDFTOTEXT_BIN, HUMETO_PDFTOPPM_BIN.
